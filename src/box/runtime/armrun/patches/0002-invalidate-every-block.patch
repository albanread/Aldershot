@@ -5,7 +5,10 @@
 
 #pragma once
 
+#include <map>
 #include <set>
+#include <utility>
+#include <vector>
 
 #include <boost/icl/interval_map.hpp>
 #include <boost/icl/interval_set.hpp>
@@ -15,15 +18,42 @@
 
 namespace Dynarmic::Backend {
 
+// ROSGD (runtime/armrun/patches/0002): the ranges waiting to be
+// invalidated, each kept as given.  Not an icl::interval_set, whose add
+// merges through the same std::map searches (below) and under libc++ can
+// leave a union wrong.  Overlaps are harmless: InvalidateRanges visits each.
+template<typename ProgramCounterType>
+class RangeSet {
+public:
+    using Interval = boost::icl::discrete_interval<ProgramCounterType>;
+    void add(Interval range) { ranges.push_back(range); }
+    void clear() { ranges.clear(); }
+    bool empty() const { return ranges.empty(); }
+    auto begin() const { return ranges.begin(); }
+    auto end() const { return ranges.end(); }
+
+private:
+    std::vector<Interval> ranges;
+};
+
 template<typename ProgramCounterType>
 class BlockRangeInformation {
 public:
     void AddRange(boost::icl::discrete_interval<ProgramCounterType> range, IR::LocationDescriptor location);
     void ClearCache();
-    tsl::robin_set<IR::LocationDescriptor> InvalidateRanges(const boost::icl::interval_set<ProgramCounterType>& ranges);
+    tsl::robin_set<IR::LocationDescriptor> InvalidateRanges(const RangeSet<ProgramCounterType>& ranges);
 
 private:
-    boost::icl::interval_map<ProgramCounterType, std::set<IR::LocationDescriptor>> block_ranges;
+    // ROSGD (runtime/armrun/patches/0002): each block's first and last
+    // address, by first address.  Not an icl::interval_map: ICL finds the
+    // segments an interval overlaps through std::map's lower_bound and
+    // upper_bound with overlap as equivalence, and libc++ searches a
+    // unique-key map by stopping at the first equivalent node -- one
+    // overlapping block, not the first (so a range over several blocks
+    // invalidated only one).  Searches here are by point, which no
+    // ordering can make ambiguous.
+    std::multimap<ProgramCounterType, std::pair<ProgramCounterType, IR::LocationDescriptor>> blocks;
+    ProgramCounterType longest = 0;     // the most any block's last exceeds its first
 };
 
 }  // namespace Dynarmic::Backend
